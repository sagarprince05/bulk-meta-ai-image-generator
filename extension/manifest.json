{
  "manifest_version": 3,
  "name": "ImageRush",
  "version": "1.6.0",
  "description": "ImageRush: type or upload prompts, generate images one by one through your own Meta AI session, and save them into organised folders.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "downloads.ui",
    "tabs",
    "alarms",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*"
  ],
  "action": {
    "default_title": "Open ImageRush"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.meta.ai/*",
        "https://meta.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bulk-meta-ai-image-generator-web.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://bulk-meta-ai-image-generator-web.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
